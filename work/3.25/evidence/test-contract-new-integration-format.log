663 + @pytest.mark.parametrize("group_by", ["date", "medication"])
664 + def test_family_history_rate_transitions__AC1_AC2_AC3(history_data, group_by):
665 +     """A family read counts a valid confirmation immediately and pending only after +120."""
666 +     data = history_data
667 +     family = data.make.family_of(data.patient)
668 +     confirmed = data.schedule()
669 +     data.schedule()
670 +     data.now = confirmed.scheduled_at + timedelta(minutes=10)
671 +     data.confirm(confirmed, data.now)
672 +     before = data.snapshot()
673 +     headers = data.auth(family)
674 +
675 +     def read():
676 +         return assert_contract(
677 +             data.client.get(
678 +                 "/adherence",
679 +                 params={
680 +                     "patient_id": str(data.patient),
681 +                     "from": DAY.date().isoformat(),
682 +                     "to": DAY.date().isoformat(),
683 +                     "group_by": group_by,
684 +                 },
685 +                 headers=headers,
686 +             )
687 +         )
688 +
689 +     immediate = read()
690 +     assert immediate["summary"] == dict(
691 +         total=2, taken=1, late=0, missed=0, pending=1, counted=1, adherence_rate=100
692 +     )
693 +     data.now = confirmed.scheduled_at + timedelta(minutes=120)
694 +     assert read()["summary"] == immediate["summary"]
695 +     data.now += timedelta(microseconds=1)
696 +     assert read()["summary"] == dict(
697 +         total=2, taken=1, late=0, missed=1, pending=0, counted=2, adherence_rate=50
698 +     )
699 +     assert data.snapshot() == before
700 +     logs = [
701 +         row
702 +         for row in data.make.access_logs(data.patient)
703 +         if row["data_scope"] == "lich_su_tuan_thu"
704 +     ]
705 +     assert len(logs) == 3
706 +     assert all(
707 +         row["actor_user_id"] == family
708 +         and row["actor_role"] == "family"
709 +         and row["result"] == "allowed"
710 +         for row in logs
711 +     )
