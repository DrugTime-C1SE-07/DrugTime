714 + @pytest.mark.parametrize("group_by", ["date", "medication"])
715 + def test_family_early_confirmation_counts_immediately__AC3(history_data, group_by):
716 +     """AC3 requires an accepted -30-minute confirmation to be visible immediately."""
717 +     data = history_data
718 +     family = data.make.family_of(data.patient)
719 +     occurrence = data.schedule()
720 +     data.now = occurrence.scheduled_at - timedelta(minutes=30)
721 +     data.confirm(occurrence, data.now)
722 +     before = data.snapshot()
723 +     body = assert_contract(
724 +         data.client.get(
725 +             "/adherence",
726 +             params={
727 +                 "patient_id": str(data.patient),
728 +                 "from": DAY.date().isoformat(),
729 +                 "to": DAY.date().isoformat(),
730 +                 "group_by": group_by,
731 +             },
732 +             headers=data.auth(family),
733 +         )
734 +     )
735 +     assert data.snapshot() == before
736 +     logs = [
737 +         row
738 +         for row in data.make.access_logs(data.patient)
739 +         if row["data_scope"] == "lich_su_tuan_thu"
740 +     ]
741 +     assert len(logs) == 1 and logs[0]["actor_user_id"] == family
742 +     assert logs[0]["result"] == "allowed"
