diff --git a/mobile/integration_test/ocr_prototype_test.dart b/mobile/integration_test/ocr_prototype_test.dart
new file mode 100644
index 0000000..e5bdc5f
--- /dev/null
+++ b/mobile/integration_test/ocr_prototype_test.dart
@@ -0,0 +1,106 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:ui' as ui;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:path/path.dart' as p;
+import 'package:drugtime_mobile/features/ocr_prototype/ocr_models.dart';
+import 'package:drugtime_mobile/features/ocr_prototype/ocr_store.dart';
+import 'package:drugtime_mobile/features/ocr_prototype/ocr_controller.dart';
+import 'package:drugtime_mobile/features/ocr_prototype/ocr_native.dart';
+
+class _FixturePicker implements OcrImagePicker {
+  _FixturePicker(this.path);
+  final String path;
+  @override
+  Future<String?> pick() async => path;
+  @override
+  Future<String?> recover() async => null;
+}
+
+void main() {
+  final binding = IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+  const base64Image = String.fromEnvironment('OCR_IMAGE_BASE64');
+  const imagePath = String.fromEnvironment('OCR_IMAGE_PATH');
+  const expected = String.fromEnvironment('OCR_EXPECTED_TEXT');
+  testWidgets('ML Kit native recognizes supplied packaging fixture offline',
+      (tester) async {
+    final dir = await Directory.systemTemp.createTemp('ocr_native_');
+    final image = File('${dir.path}/fixture.png');
+    final root = Directory(
+        p.join((await getApplicationSupportDirectory()).path, 'ocr_runs'));
+    final store = FileOcrStore(root);
+    final controller = OcrController(
+        engine: MlKitOcrEngine(),
+        picker: _FixturePicker(image.path),
+        store: store,
+        rootPath: root.path);
+    try {
+      await image.writeAsBytes(imagePath.isEmpty
+          ? base64Decode(base64Image)
+          : await File(imagePath).readAsBytes());
+      await controller.initialize();
+      await controller.pick();
+      await controller.run(
+          const String.fromEnvironment('OCR_IMAGE_ID',
+              defaultValue: 'native-fixture'),
+          {
+            'platform': 'Android',
+            'deviceModel': const String.fromEnvironment('OCR_DEVICE_MODEL'),
+            'osVersion': const String.fromEnvironment('OCR_OS_VERSION'),
+            'appRevision': const String.fromEnvironment('OCR_APP_REVISION'),
+            'nativeSdkVersion':
+                const String.fromEnvironment('OCR_NATIVE_SDK_VERSION'),
+            'deviceKind': const String.fromEnvironment('OCR_DEVICE_KIND',
+                defaultValue: 'unspecified'),
+            'purpose': 'native_smoke_pilot',
+            'imageSource': const String.fromEnvironment('OCR_IMAGE_SOURCE',
+                defaultValue: 'tester_supplied_fixture'),
+            'datasetVersion': 'pilot_only_unverified',
+          });
+      expect(controller.saved, isTrue, reason: controller.message);
+      final run = controller.result!;
+      expect(run.status, 'text');
+      expect(run.rawText, isNotEmpty);
+      if (expected.isNotEmpty) expect(run.rawText, contains(expected));
+      final exported = await store.export(run);
+      final decoded = OcrRun.fromJson(
+          jsonDecode(await exported.readAsString()) as Map<String, dynamic>);
+      expect(decoded.encode(), run.encode());
+      binding.reportData = {
+        'rawExports': [await exported.readAsString()]
+      };
+      expect((await store.load()).any((entry) => entry.id == run.id), isTrue);
+    } finally {
+      controller.dispose();
+      await controller.closed;
+      await dir.delete(recursive: true);
+    }
+  }, skip: base64Image.isEmpty && imagePath.isEmpty);
+  testWidgets(
+      'native blank image returns no text; invalid image rejected before engine',
+      (tester) async {
+    final dir = await Directory.systemTemp.createTemp('ocr_blank_');
+    final engine = MlKitOcrEngine();
+    final recorder = ui.PictureRecorder();
+    final canvas = ui.Canvas(recorder);
+    canvas.drawColor(const ui.Color(0xFFFFFFFF), ui.BlendMode.src);
+    final picture = recorder.endRecording();
+    final image = await picture.toImage(100, 100);
+    try {
+      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+      final file = File('${dir.path}/blank.png');
+      await file.writeAsBytes(bytes!.buffer.asUint8List());
+      expect((await engine.recognize(file.path)).trim(), isEmpty);
+      final bad = File('${dir.path}/bad.png');
+      await bad.writeAsString('not an image');
+      await expectLater(validateOcrImage(bad.path), throwsA(anything));
+    } finally {
+      image.dispose();
+      picture.dispose();
+      await engine.close();
+      await dir.delete(recursive: true);
+    }
+  });
+}
diff --git a/mobile/lib/features/ocr_prototype/ocr_controller.dart b/mobile/lib/features/ocr_prototype/ocr_controller.dart
new file mode 100644
index 0000000..7730a07
--- /dev/null
+++ b/mobile/lib/features/ocr_prototype/ocr_controller.dart
@@ -0,0 +1,203 @@
+import 'dart:async';
+import 'dart:io';
+import 'dart:ui' as ui;
+import 'package:flutter/foundation.dart';
+import 'package:path/path.dart' as p;
+import '../../core/storage/local_db/client_uuid.dart';
+import 'ocr_models.dart';
+
+Future<void> validateOcrImage(String path) async {
+  final codec = await ui.instantiateImageCodec(await File(path).readAsBytes());
+  codec.dispose();
+}
+
+class OcrController extends ChangeNotifier {
+  OcrController(
+      {required this.engine,
+      required this.picker,
+      required this.store,
+      required this.rootPath,
+      this.supported = true,
+      this.validateImage = validateOcrImage,
+      String Function()? newId})
+      : newId = newId ?? createClientUuid;
+  final OcrEngine engine;
+  final OcrImagePicker picker;
+  final OcrStore store;
+  final String rootPath;
+  final bool supported;
+  final Future<void> Function(String) validateImage;
+  final String Function() newId;
+  bool busy = false, disposed = false;
+  int _generation = 0;
+  String? image, message, resourceError;
+  OcrRun? result;
+  bool saved = false;
+  List<OcrRun> history = [];
+  Future<void>? _active;
+  Future<void>? closed;
+  void _emit(int generation) {
+    if (!disposed && generation == _generation) notifyListeners();
+  }
+
+  Future<void> _exclusive(Future<void> Function(int) action) async {
+    if (busy || disposed || !supported) return;
+    busy = true;
+    final generation = ++_generation;
+    message = null;
+    _emit(generation);
+    final operation = Future<void>.sync(() => action(generation));
+    _active = operation;
+    try {
+      await operation;
+    } finally {
+      busy = false;
+      _emit(generation);
+    }
+  }
+
+  Future<void> initialize() => _exclusive((generation) async {
+        try {
+          history = await store.load();
+        } catch (_) {
+          message = 'Không đọc được lịch sử. Kiểm tra bộ nhớ và thử lại.';
+        }
+        try {
+          final recovered = await picker.recover();
+          if (!disposed && recovered != null) {
+            image = recovered;
+            message = 'Đã khôi phục ảnh đã chọn. Kiểm tra mã ảnh rồi chạy lại.';
+          }
+        } catch (_) {
+          message = 'Không khôi phục được ảnh. Hãy chọn ảnh khác.';
+        }
+      });
+  Future<void> pick() => _exclusive((generation) async {
+        if (result != null && !saved) {
+          message = 'Lưu kết quả hiện tại trước khi đổi ảnh.';
+          return;
+        }
+        try {
+          final selected = await picker.pick();
+          if (disposed) return;
+          if (selected == null) {
+            message = 'Đã hủy chọn ảnh.';
+            return;
+          }
+          image = selected;
+          result = null;
+          saved = false;
+        } catch (_) {
+          message = 'Không mở được thư viện ảnh. Kiểm tra quyền và thử lại.';
+        }
+      });
+  Future<void> run(String imageId, Map<String, String> metadata) =>
+      _exclusive((generation) async {
+        if (result != null && !saved) {
+          message = 'Lưu kết quả hiện tại trước khi chạy tiếp.';
+          return;
+        }
+        const requiredKeys = [
+          'platform',
+          'deviceModel',
+          'osVersion',
+          'appRevision',
+          'nativeSdkVersion'
+        ];
+        if (image == null ||
+            imageId.trim().isEmpty ||
+            requiredKeys.any((key) => (metadata[key] ?? '').trim().isEmpty)) {
+          message =
+              'Chọn ảnh và điền đủ mã ảnh, thiết bị, OS, revision và native SDK.';
+          return;
+        }
+        final source = image!;
+        final id = newId();
+        String? relative;
+        String raw = '', status = 'input_error';
+        String? errorCode;
+        final timer = Stopwatch();
+        try {
+          await validateImage(source);
+          relative = await store.prepareImage(id, source);
+        } catch (_) {
+          errorCode = 'image_unavailable_or_invalid';
+        }
+        if (relative != null) {
+          timer.start();
+          try {
+            raw = await engine.recognize(p.join(rootPath, relative));
+            status = raw.trim().isEmpty ? 'no_text' : 'text';
+          } catch (_) {
+            status = 'engine_error';
+            errorCode = 'recognition_failed';
+          } finally {
+            timer.stop();
+          }
+        }
+        final timestamp = DateTime.now().toUtc().add(const Duration(hours: 7));
+        result = OcrRun(
+            id: id,
+            imageId: imageId.trim(),
+            createdAt:
+                '${timestamp.toIso8601String().replaceAll('Z', '')}+07:00',
+            rawText: raw,
+            status: status,
+            elapsedMs: timer.elapsedMilliseconds,
+            imagePath: relative,
+            errorCode: errorCode,
+            metadata: {
+              ...metadata,
+              'engine': 'google_mlkit_text_recognition',
+              'packageVersion': '0.17.1',
+              'script': 'latin',
+              'preprocessing': 'none',
+              'modelVersion': 'not_exposed',
+              'metadataSource': 'tester_confirmed',
+              'timezone': 'Asia/Ho_Chi_Minh'
+            });
+        saved = false;
+        await _persist();
+      });
+  Future<void> _persist() async {
+    final run = result;
+    if (run == null) return;
+    try {
+      await store.save(run);
+      saved = true;
+      history = [run, ...history.where((entry) => entry.id != run.id)];
+    } catch (_) {
+      message = 'Chưa lưu được kết quả. Giữ màn hình và bấm Lưu lại.';
+    }
+  }
+
+  Future<void> retrySave() => _exclusive((_) async {
+        if (!saved) await _persist();
+      });
+  Future<void> export(OcrRun run, OcrExporter exporter, ui.Rect origin) =>
+      _exclusive((_) async {
+        try {
+          final file = await store.export(run);
+          final shared = await exporter.share(file, origin);
+          message = shared
+              ? 'Đã chia sẻ JSON.'
+              : 'Chưa xác nhận chia sẻ; bản lưu vẫn còn trên thiết bị.';
+        } catch (_) {
+          message = 'Không xuất được JSON. Bản lưu được giữ lại; hãy thử lại.';
+        }
+      });
+  @override
+  void dispose() {
+    disposed = true;
+    _generation++;
+    closed = () async {
+      try {
+        await _active;
+        await engine.close();
+      } catch (_) {
+        resourceError = 'engine_close_failed';
+      }
+    }();
+    super.dispose();
+  }
+}
diff --git a/mobile/lib/features/ocr_prototype/ocr_models.dart b/mobile/lib/features/ocr_prototype/ocr_models.dart
new file mode 100644
index 0000000..2eea884
--- /dev/null
+++ b/mobile/lib/features/ocr_prototype/ocr_models.dart
@@ -0,0 +1,70 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:ui' show Rect;
+
+/// Local experiment only: this schema is independent of patient/medication APIs.
+class OcrRun {
+  OcrRun(
+      {required this.id,
+      required this.imageId,
+      required this.createdAt,
+      required this.rawText,
+      required this.status,
+      required this.elapsedMs,
+      required this.metadata,
+      this.imagePath,
+      this.errorCode});
+  final String id, imageId, createdAt, rawText, status;
+  final int elapsedMs;
+  final Map<String, String> metadata;
+  final String? imagePath, errorCode;
+  Map<String, Object?> toJson() => {
+        'schemaVersion': 1,
+        'runId': id,
+        'imageId': imageId,
+        'createdAt': createdAt,
+        'rawText': rawText,
+        'status': status,
+        'elapsedMs': elapsedMs,
+        'metadata': metadata,
+        'imagePath': imagePath,
+        'errorCode': errorCode
+      };
+  factory OcrRun.fromJson(Map<String, dynamic> json) {
+    if (json['schemaVersion'] != 1) {
+      throw const FormatException('Unsupported schema');
+    }
+    return OcrRun(
+        id: json['runId'] as String,
+        imageId: json['imageId'] as String,
+        createdAt: json['createdAt'] as String,
+        rawText: json['rawText'] as String,
+        status: json['status'] as String,
+        elapsedMs: json['elapsedMs'] as int,
+        metadata: Map<String, String>.from(json['metadata'] as Map),
+        imagePath: json['imagePath'] as String?,
+        errorCode: json['errorCode'] as String?);
+  }
+  String encode() => const JsonEncoder.withIndent('  ').convert(toJson());
+}
+
+abstract interface class OcrEngine {
+  Future<String> recognize(String path);
+  Future<void> close();
+}
+
+abstract interface class OcrImagePicker {
+  Future<String?> pick();
+  Future<String?> recover();
+}
+
+abstract interface class OcrStore {
+  Future<String> prepareImage(String runId, String source);
+  Future<void> save(OcrRun run);
+  Future<List<OcrRun>> load();
+  Future<File> export(OcrRun run);
+}
+
+abstract interface class OcrExporter {
+  Future<bool> share(File file, Rect origin);
+}
diff --git a/mobile/lib/features/ocr_prototype/ocr_native.dart b/mobile/lib/features/ocr_prototype/ocr_native.dart
new file mode 100644
index 0000000..6df9c36
--- /dev/null
+++ b/mobile/lib/features/ocr_prototype/ocr_native.dart
@@ -0,0 +1,52 @@
+import 'dart:io';
+import 'dart:ui';
+import 'package:flutter/foundation.dart';
+import 'package:google_mlkit_text_recognition/google_mlkit_text_recognition.dart';
+import 'package:image_picker/image_picker.dart';
+import 'package:share_plus/share_plus.dart';
+import 'ocr_models.dart';
+
+bool get supportsNativeOcr => !kIsWeb && Platform.isAndroid;
+
+class MlKitOcrEngine implements OcrEngine {
+  TextRecognizer? _recognizer;
+  @override
+  Future<String> recognize(String path) async {
+    if (!supportsNativeOcr) throw UnsupportedError('Android required');
+    _recognizer ??= TextRecognizer(script: TextRecognitionScript.latin);
+    return (await _recognizer!.processImage(InputImage.fromFilePath(path)))
+        .text;
+  }
+
+  @override
+  Future<void> close() async {
+    await _recognizer?.close();
+    _recognizer = null;
+  }
+}
+
+class GalleryOcrPicker implements OcrImagePicker {
+  GalleryOcrPicker({ImagePicker? picker}) : _picker = picker ?? ImagePicker();
+  final ImagePicker _picker;
+  @override
+  Future<String?> pick() async => (await _picker.pickImage(
+          source: ImageSource.gallery, requestFullMetadata: false))
+      ?.path;
+  @override
+  Future<String?> recover() async {
+    if (!Platform.isAndroid) return null;
+    final response = await _picker.retrieveLostData();
+    if (response.exception != null) throw response.exception!;
+    return response.files?.firstOrNull?.path;
+  }
+}
+
+class SystemOcrExporter implements OcrExporter {
+  @override
+  Future<bool> share(File file, Rect origin) async {
+    final result = await SharePlus.instance.share(ShareParams(
+        files: [XFile(file.path, mimeType: 'application/json')],
+        sharePositionOrigin: origin));
+    return result.status == ShareResultStatus.success;
+  }
+}
diff --git a/mobile/lib/features/ocr_prototype/ocr_screen.dart b/mobile/lib/features/ocr_prototype/ocr_screen.dart
new file mode 100644
index 0000000..336b76c
--- /dev/null
+++ b/mobile/lib/features/ocr_prototype/ocr_screen.dart
@@ -0,0 +1,139 @@
+import 'dart:io';
+import 'package:flutter/material.dart';
+import '../../app/theme/app_theme.dart';
+import 'ocr_controller.dart';
+import 'ocr_models.dart';
+
+class OcrPrototypeScreen extends StatefulWidget {
+  const OcrPrototypeScreen(
+      {super.key, required this.controller, required this.exporter});
+  final OcrController controller;
+  final OcrExporter exporter;
+  @override
+  State<OcrPrototypeScreen> createState() => _OcrPrototypeScreenState();
+}
+
+class _OcrPrototypeScreenState extends State<OcrPrototypeScreen> {
+  final _fields = <String, TextEditingController>{
+    for (final key in [
+      'imageId',
+      'platform',
+      'deviceModel',
+      'osVersion',
+      'appRevision',
+      'nativeSdkVersion'
+    ])
+      key: TextEditingController(),
+  };
+  @override
+  void initState() {
+    super.initState();
+    widget.controller.initialize();
+  }
+
+  @override
+  void dispose() {
+    widget.controller.dispose();
+    for (final field in _fields.values) {
+      field.dispose();
+    }
+    super.dispose();
+  }
+
+  Widget _share(OcrRun run) => Builder(
+      builder: (context) => TextButton(
+          key: ValueKey('export-${run.id}'),
+          onPressed: widget.controller.busy
+              ? null
+              : () {
+                  final box = context.findRenderObject()! as RenderBox;
+                  widget.controller.export(run, widget.exporter,
+                      box.localToGlobal(Offset.zero) & box.size);
+                },
+          child: const Text('Xuất JSON')));
+  @override
+  Widget build(BuildContext context) => Scaffold(
+      appBar: AppBar(title: const Text('Thử nghiệm OCR ML Kit')),
+      body: AnimatedBuilder(
+          animation: widget.controller,
+          builder: (context, _) {
+            final c = widget.controller;
+            if (!c.supported) {
+              return const Center(
+                  child: Text('Prototype OCR chỉ hỗ trợ Android.'));
+            }
+            const labels = {
+              'imageId': 'Mã ảnh trong bộ dữ liệu',
+              'platform': 'Nền tảng (Android)',
+              'deviceModel': 'Model thiết bị',
+              'osVersion': 'Phiên bản OS',
+              'appRevision': 'Revision bản build',
+              'nativeSdkVersion': 'Native SDK từ lock/build evidence'
+            };
+            return ListView(
+                padding: const EdgeInsets.all(AppSpacing.lg),
+                children: [
+                  const Text(
+                      'Chỉ thử ảnh bao bì thuốc. Kết quả OCR chưa được xác minh, không dùng để quyết định dùng thuốc.'),
+                  const SizedBox(height: AppSpacing.lg),
+                  OutlinedButton(
+                      key: const Key('pick-image'),
+                      onPressed: c.busy || (c.result != null && !c.saved)
+                          ? null
+                          : c.pick,
+                      child: const Text('Chọn ảnh có sẵn')),
+                  if (c.image != null)
+                    Image.file(File(c.image!),
+                        height: 200,
+                        fit: BoxFit.contain,
+                        errorBuilder: (_, __, ___) => const Text(
+                            'Không xem được ảnh; hãy chọn ảnh khác.')),
+                  for (final entry in labels.entries)
+                    Padding(
+                        padding: const EdgeInsets.only(bottom: AppSpacing.md),
+                        child: TextField(
+                            key: ValueKey(entry.key),
+                            controller: _fields[entry.key],
+                            enabled: !c.busy,
+                            decoration:
+                                InputDecoration(labelText: entry.value))),
+                  const Text(
+                      'Xác nhận thông tin thiết bị/build ở trên trước mỗi lần chạy.'),
+                  FilledButton(
+                      key: const Key('run-ocr'),
+                      onPressed: c.busy || (c.result != null && !c.saved)
+                          ? null
+                          : () => c.run(_fields['imageId']!.text, {
+                                for (final entry in _fields.entries)
+                                  if (entry.key != 'imageId')
+                                    entry.key: entry.value.text
+                              }),
+                      child: const Text('Chạy OCR')),
+                  if (c.busy) const LinearProgressIndicator(),
+                  if (c.message != null)
+                    Semantics(liveRegion: true, child: Text(c.message!)),
+                  if (c.result case final run?) ...[
+                    Text(
+                        '${run.status} · ${run.elapsedMs} ms · ${run.createdAt}'),
+                    SelectableText(run.rawText.isEmpty
+                        ? '(Không có raw text)'
+                        : run.rawText),
+                    Text(c.saved
+                        ? 'Đã lưu trên thiết bị · ${run.id}'
+                        : 'Chưa lưu'),
+                    if (!c.saved)
+                      TextButton(
+                          key: const Key('retry-save'),
+                          onPressed: c.busy ? null : c.retrySave,
+                          child: const Text('Lưu lại')),
+                  ],
+                  const SizedBox(height: AppSpacing.lg),
+                  const Text('Lịch sử trên thiết bị'),
+                  for (final run in c.history)
+                    ListTile(
+                        title: Text('${run.imageId} · ${run.status}'),
+                        subtitle: SelectableText('${run.id}\n${run.rawText}'),
+                        trailing: _share(run)),
+                ]);
+          }));
+}
diff --git a/mobile/lib/features/ocr_prototype/ocr_store.dart b/mobile/lib/features/ocr_prototype/ocr_store.dart
new file mode 100644
index 0000000..a96174f
--- /dev/null
+++ b/mobile/lib/features/ocr_prototype/ocr_store.dart
@@ -0,0 +1,85 @@
+import 'dart:convert';
+import 'dart:io';
+import 'package:path/path.dart' as p;
+import 'ocr_models.dart';
+
+/// Private application-support directory; no patient identifiers or cloud writes.
+class FileOcrStore implements OcrStore {
+  FileOcrStore(this.root);
+  final Directory root;
+  void _checkId(String id) {
+    if (!RegExp(r'^[a-zA-Z0-9_-]+$').hasMatch(id)) {
+      throw const FormatException('Invalid run ID');
+    }
+  }
+
+  File _runFile(String id) {
+    _checkId(id);
+    return File(p.join(root.path, '$id.json'));
+  }
+
+  @override
+  Future<String> prepareImage(String runId, String source) async {
+    _checkId(runId);
+    final bytes = await File(source).readAsBytes();
+    if (bytes.isEmpty) throw const FormatException('Empty image');
+    await root.create(recursive: true);
+    final dir = Directory(p.join(root.path, runId));
+    if (await dir.exists()) {
+      throw const FileSystemException('Run already exists');
+    }
+    await dir.create();
+    // Preserve the original encoding and extension; no resizing/recompression.
+    final name = '$runId/image${p.extension(source)}';
+    final destination = File(p.join(root.path, name));
+    await destination.create(exclusive: true);
+    await destination.writeAsBytes(bytes, flush: true);
+    return name;
+  }
+
+  @override
+  Future<void> save(OcrRun run) async {
+    final target = _runFile(run.id);
+    await root.create(recursive: true);
+    // An exclusive lock serializes writers and prevents rename overwriting a run.
+    final lock = File('${target.path}.lock');
+    await lock.create(exclusive: true);
+    final temporary = File('${target.path}.tmp');
+    try {
+      if (await target.exists()) {
+        throw const FileSystemException('Run already saved');
+      }
+      await temporary.writeAsString(run.encode(), encoding: utf8, flush: true);
+      await temporary.rename(target.path);
+    } finally {
+      if (await temporary.exists()) await temporary.delete();
+      await lock.delete();
+    }
+  }
+
+  @override
+  Future<List<OcrRun>> load() async {
+    if (!await root.exists()) return [];
+    final runs = <OcrRun>[];
+    await for (final entity in root.list()) {
+      if (entity is File && p.extension(entity.path) == '.json') {
+        runs.add(OcrRun.fromJson(
+            jsonDecode(await entity.readAsString()) as Map<String, dynamic>));
+      }
+    }
+    runs.sort((a, b) => b.createdAt.compareTo(a.createdAt));
+    return runs;
+  }
+
+  @override
+  Future<File> export(OcrRun run) async {
+    // Sharing this complete immutable JSON does not attach its image.
+    final file = _runFile(run.id);
+    final stored = OcrRun.fromJson(
+        jsonDecode(await file.readAsString()) as Map<String, dynamic>);
+    if (stored.encode() != run.encode()) {
+      throw const FormatException('Stored run mismatch');
+    }
+    return file;
+  }
+}
diff --git a/mobile/lib/main_ocr_prototype.dart b/mobile/lib/main_ocr_prototype.dart
new file mode 100644
index 0000000..965ad5c
--- /dev/null
+++ b/mobile/lib/main_ocr_prototype.dart
@@ -0,0 +1,40 @@
+import 'dart:io';
+import 'package:flutter/material.dart';
+import 'package:path/path.dart' as p;
+import 'package:path_provider/path_provider.dart';
+import 'app/theme/app_theme.dart';
+import 'features/ocr_prototype/ocr_controller.dart';
+import 'features/ocr_prototype/ocr_native.dart';
+import 'features/ocr_prototype/ocr_screen.dart';
+import 'features/ocr_prototype/ocr_store.dart';
+
+Future<void> main() async {
+  WidgetsFlutterBinding.ensureInitialized();
+  if (!supportsNativeOcr) {
+    runApp(MaterialApp(
+        theme: buildAppTheme(),
+        home: const Scaffold(
+            body: Center(child: Text('Prototype OCR chỉ hỗ trợ Android.')))));
+    return;
+  }
+  try {
+    final root = Directory(
+        p.join((await getApplicationSupportDirectory()).path, 'ocr_runs'));
+    final controller = OcrController(
+        engine: MlKitOcrEngine(),
+        picker: GalleryOcrPicker(),
+        store: FileOcrStore(root),
+        rootPath: root.path);
+    runApp(MaterialApp(
+        theme: buildAppTheme(),
+        home: OcrPrototypeScreen(
+            controller: controller, exporter: SystemOcrExporter())));
+  } catch (_) {
+    runApp(MaterialApp(
+        theme: buildAppTheme(),
+        home: const Scaffold(
+            body: Center(
+                child: Text(
+                    'Không mở được bộ nhớ thử nghiệm. Hãy đóng và mở lại ứng dụng.')))));
+  }
+}
