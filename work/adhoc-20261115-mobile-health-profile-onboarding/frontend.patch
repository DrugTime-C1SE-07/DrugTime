+import 'package:flutter/material.dart';
+
+import '../../domain/repositories/health_setup_repository.dart';
+import '../state/health_setup_controller.dart';
+import '../widgets/health_setup_custom_sheet.dart';
+import '../widgets/health_setup_form.dart';
+import 'health_setup_complete_screen.dart';
+
+class HealthSetupScreen extends StatefulWidget {
+  const HealthSetupScreen({super.key, required this.repository});
+  final HealthSetupRepository? repository;
+
+  @override
+  State<HealthSetupScreen> createState() => _HealthSetupScreenState();
+}
+
+class _HealthSetupScreenState extends State<HealthSetupScreen> {
+  late final _controller = HealthSetupController(widget.repository);
+  bool _allergy = true;
+  String? _inputError;
+
+  @override
+  void initState() {
+    super.initState();
+    _controller.load();
+  }
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  void _back() {
+    if (_controller.saved != null) {
+      Navigator.pop(context, true);
+      return;
+    }
+    if (_controller.saving) return;
+    if (_allergy) {
+      Navigator.pop(context);
+    } else {
+      setState(() {
+        _allergy = true;
+        _inputError = null;
+      });
+    }
+  }
+
+  Future<void> _advance({required bool include}) async {
+    if (_allergy) {
+      _controller.includeAllergies(include);
+      setState(() {
+        _allergy = false;
+        _inputError = null;
+      });
+      return;
+    }
+    final result = await _controller.finish(includeConditions: include);
+    if (mounted && result == HealthSetupSaveResult.skipped) {
+      Navigator.pop(context, true);
+    }
+  }
+
+  Future<void> _showCustom() async {
+    final value = await showHealthSetupCustomSheet(context, allergy: _allergy);
+    if (!mounted || value == null) return;
+    final accepted = _allergy
+        ? _controller.allergyDraft.addCustom(value)
+        : _controller.conditionDraft.addCustom(value);
+    setState(() =>
+        _inputError = accepted ? null : 'Mục đã có hoặc tên không hợp lệ.');
+  }
+
+  String? _warning() {
+    if (_inputError != null) return _inputError;
+    if (_controller.conflict) {
+      final current = _controller.snapshot!;
+      final conditions = healthSetupSummary(current.conditions,
+          _controller.conditionOptions, 'Không có bệnh nền đã biết');
+      final allergies = healthSetupSummary(current.allergies,
+          _controller.allergenOptions, 'Không có dị ứng đã biết');
+      return 'Hồ sơ đã thay đổi. Đang lưu: dị ứng – $allergies; bệnh nền – $conditions. '
+          'Kiểm tra lựa chọn của bạn trước khi bấm Tiếp tục để lưu lại.';
+    }
+    if (_controller.saveFailed) return 'Chưa lưu được hồ sơ. Vui lòng thử lại.';
+    return null;
+  }
+
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+        animation: _controller,
+        builder: (context, _) {
+          final saved = _controller.saved;
+          return Theme(
+            data: Theme.of(context).copyWith(
+              textTheme:
+                  Theme.of(context).textTheme.apply(fontFamily: 'WelcomeInter'),
+            ),
+            child: PopScope(
+              canPop: saved == null && _allergy && !_controller.saving,
+              onPopInvokedWithResult: (didPop, _) {
+                if (!didPop && !_controller.saving) _back();
+              },
+              child: saved != null
+                  ? HealthSetupCompleteScreen(
+                      snapshot: saved,
+                      allergens: _controller.allergenOptions,
+                      conditions: _controller.conditionOptions,
+                      onHome: () => Navigator.pop(context, true))
+                  : _form(),
+            ),
+          );
+        },
+      );
+
+  Widget _form() {
+    final ready = _controller.snapshot != null;
+    final enabled = ready && !_controller.saving;
+    final canContinue = enabled &&
+        (_allergy
+            ? _controller.allergyDraft.canContinue
+            : _controller.conditionDraft.canContinue);
+    final warning = _warning();
+    return Scaffold(
+      backgroundColor: healthSetupPaper,
+      bottomNavigationBar: ready
+          ? HealthSetupActionBar(
+              label: 'Tiếp tục',
+              saving: _controller.saving,
+              onPressed: canContinue ? () => _advance(include: true) : null,
+            )
+          : null,
+      body: SafeArea(
+        bottom: false,
+        child: Column(
+          children: [
+            HealthSetupHeader(
+              back: _controller.saving ? null : _back,
+              skip: enabled ? () => _advance(include: false) : null,
+            ),
+            Expanded(
+              child: _controller.loading
+                  ? const Center(child: CircularProgressIndicator())
+                  : _controller.loadFailed
+                      ? Center(
+                          child: Padding(
+                          padding: const EdgeInsets.all(20),
+                          child:
+                              Column(mainAxisSize: MainAxisSize.min, children: [
+                            const Text('Chưa tải được hồ sơ sức khỏe.'),
+                            TextButton(
+                                onPressed: _controller.load,
+                                child: const Text('Thử lại')),
+                          ]),
+                        ))
+                      : AbsorbPointer(
+                          absorbing: _controller.saving,
+                          child: _allergy
+                              ? HealthSetupForm(
+                                  key: const ValueKey('allergies'),
+                                  allergy: true,
+                                  options: _controller.allergenOptions,
+                                  draft: _controller.allergyDraft,
+                                  warning: warning,
+                                  onChanged: () =>
+                                      setState(() => _inputError = null),
+                                  onAdd: _showCustom)
+                              : HealthSetupForm(
+                                  key: const ValueKey('conditions'),
+                                  allergy: false,
+                                  options: _controller.conditionOptions,
+                                  draft: _controller.conditionDraft,
+                                  warning: warning,
+                                  onChanged: () =>
+                                      setState(() => _inputError = null),
+                                  onAdd: _showCustom),
+                        ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/mobile/lib/features/profile/presentation/state/health_setup_controller.dart b/mobile/lib/features/profile/presentation/state/health_setup_controller.dart
new file mode 100644
index 0000000..a4860d0
--- /dev/null
+++ b/mobile/lib/features/profile/presentation/state/health_setup_controller.dart
@@ -0,0 +1,156 @@
+import 'package:flutter/foundation.dart';
+
+import '../../domain/entities/health_setup.dart';
+import '../../domain/repositories/health_setup_repository.dart';
+
+class HealthSetupDraft<T> {
+  HealthSetupDraft(HealthSetupStep<T> step)
+      : ids = Set<T>.of(step.ids),
+        names = step.names.toList(),
+        noneKnown = step.status == HealthSetupStatus.noneKnown;
+
+  final Set<T> ids;
+  final List<String> names;
+  bool noneKnown;
+  bool get canContinue => noneKnown || ids.isNotEmpty || names.isNotEmpty;
+
+  void toggle(T id) {
+    noneKnown = false;
+    if (!ids.add(id)) ids.remove(id);
+  }
+
+  void toggleNone() {
+    noneKnown = !noneKnown;
+    if (noneKnown) {
+      ids.clear();
+      names.clear();
+    }
+  }
+
+  bool addCustom(String input) {
+    final name = input.trim();
+    if (name.isEmpty ||
+        names.length >= 30 ||
+        name.runes.length > 120 ||
+        name.contains('\u0000') ||
+        names.any((value) => value.toLowerCase() == name.toLowerCase())) {
+      return false;
+    }
+    names.add(name);
+    noneKnown = false;
+    return true;
+  }
+
+  HealthSetupStep<T> get value => HealthSetupStep(
+        noneKnown
+            ? HealthSetupStatus.noneKnown
+            : canContinue
+                ? HealthSetupStatus.reported
+                : HealthSetupStatus.unreported,
+        ids: ids.toList(),
+        names: names.toList(),
+      );
+}
+
+enum HealthSetupSaveResult { saved, skipped, failed }
+
+class HealthSetupController extends ChangeNotifier {
+  HealthSetupController(this._repository);
+
+  final HealthSetupRepository? _repository;
+  HealthSetupSnapshot? snapshot;
+  HealthSetupSnapshot? saved;
+  late HealthSetupDraft<String> allergyDraft;
+  late HealthSetupDraft<int> conditionDraft;
+  List<HealthSetupOption<String>> allergenOptions = const [];
+  List<HealthSetupOption<int>> conditionOptions = const [];
+  bool loading = false;
+  bool loadFailed = false;
+  bool saving = false;
+  bool saveFailed = false;
+  bool conflict = false;
+  bool _disposed = false;
+  bool _includeAllergies = false;
+
+  Future<void> load() async {
+    if (loading) return;
+    loading = true;
+    loadFailed = false;
+    notifyListeners();
+    try {
+      final repo = _repository;
+      if (repo == null) throw StateError('Health setup unavailable');
+      final (profile, allergens, conditions) =
+          await (repo.read(), repo.allergens(), repo.conditions()).wait;
+      if (_disposed) return;
+      snapshot = profile;
+      allergenOptions = allergens;
+      conditionOptions = conditions;
+      allergyDraft = HealthSetupDraft(profile.allergies);
+      conditionDraft = HealthSetupDraft(profile.conditions);
+    } catch (_) {
+      if (!_disposed) loadFailed = true;
+    } finally {
+      if (!_disposed) {
+        loading = false;
+        notifyListeners();
+      }
+    }
+  }
+
+  void includeAllergies(bool include) => _includeAllergies = include;
+
+  Future<HealthSetupSaveResult> finish(
+      {required bool includeConditions}) async {
+    final profile = snapshot;
+    final repo = _repository;
+    if (profile == null || repo == null || saving) {
+      return HealthSetupSaveResult.failed;
+    }
+    final allergies = _includeAllergies ? allergyDraft.value : null;
+    final conditions = includeConditions ? conditionDraft.value : null;
+    if (allergies == null && conditions == null) {
+      return HealthSetupSaveResult.skipped;
+    }
+    saving = true;
+    saveFailed = false;
+    conflict = false;
+    notifyListeners();
+    try {
+      saved = await repo.save(profile.revision,
+          allergies: allergies, conditions: conditions);
+      return HealthSetupSaveResult.saved;
+    } on HealthSetupSaveException catch (error) {
+      if (error.needsReadback && !_disposed) {
+        try {
+          final fresh = await repo.read();
+          if (_disposed) return HealthSetupSaveResult.failed;
+          final same =
+              (allergies == null || allergies.matches(fresh.allergies)) &&
+                  (conditions == null || conditions.matches(fresh.conditions));
+          if (same) {
+            saved = fresh;
+            return HealthSetupSaveResult.saved;
+          }
+          conflict = fresh.revision != profile.revision;
+          snapshot = fresh;
+        } catch (_) {
+          // A failed readback leaves the prior revision in place for retry.
+        }
+      }
+      saveFailed = true;
+      return HealthSetupSaveResult.failed;
+    } finally {
+      if (!_disposed) {
+        saving = false;
+        notifyListeners();
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    super.dispose();
+  }
+}
